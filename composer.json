{
    "name": "gemorroj/logio",
    "description": "log parser",
    "keywords": ["php", "php-fpm", "mysql", "apache", "nginx", "log", "logger"],
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Gemorroj"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/config": "^7.4||^8.0",
        "symfony/yaml": "^7.4||^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5||^13",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Logio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Logio\\Tests\\": "tests/"
        }
    }
}
